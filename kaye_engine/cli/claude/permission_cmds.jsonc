/*
################################################################################
# permission_cmds.jsonc
#
# Bash command patterns for the ask / deny / allow permissions lists,
# written to the corresponding "permissions" fields in settings.json
################################################################################
*/

// Todo update git worktree related
{
  "allow": [  //  ##############################################################
    // git  --------------------------------------------------------------------
    "Bash(git status)",
    "Bash(git diff*)",
    "Bash(git log*)",
    "Bash(git fetch*)",
    "Bash(git show*)",
    "Bash(git blame*)",
    "Bash(git describe*)",
    "Bash(git fsck*)",
    "Bash(git grep*)",
    "Bash(git verify-commit*)",
    "Bash(git verify-tag*)",
    "Bash(git rev-parse*)",
    "Bash(git ls-files*)",
    "Bash(git cat-file*)",
    "Bash(git count-objects*)",
    "Bash(git shortlog*)",
    "Bash(git whatchanged*)",
    "Bash(git add -n*)",
    "Bash(git add --dry-run*)",
    "Bash(git branch)",
    "Bash(git branch -a*)",
    "Bash(git branch -r*)",
    "Bash(git branch -v*)",
    "Bash(git branch --list*)",
    "Bash(git worktree list*)",
    "Bash(git stash list*)",
    "Bash(git stash show*)"
  ],
  "ask": [  // #################################################################
    // system commands  --------------------------------------------------------
    "Bash(sudo *)",
    "Bash(su)",
    "Bash(kill *)",
    "Bash(killall *)",
    "Bash(shutdown *)",
    "Bash(reboot)",
    "Bash(systemctl *)",
    // packages  ---------------------------------------------------------------
    "Bash(npm install *)",
    "Bash(brew install *)",
    "Bash(apt *)",
    // Python  -----------------------------------------------------------------
    "Bash(pip install *)",
    "Bash(pytest .)",
    "Bash(pytest tests*)",
    // git  --------------------------------------------------------------------
    "Bash(git merge*)",
    "Bash(git reset*)",
    "Bash(git push*)",
    "Bash(git rebase*)",
    "Bash(git checkout*)",
    "Bash(git restore*)",
    "Bash(git tag*)",
    "Bash(git gc*)",
    "Bash(git reflog*)",
    "Bash(git update-ref*)",
    "Bash(git filter-branch*)",
    "Bash(git filter-repo*)",
    "Bash(git submodule*)",
    "Bash(git rm*)",
    "Bash(git remote*)",
    "Bash(git config*)",
    "Bash(git cherry-pick*)",
    "Bash(git revert*)",
    "Bash(git bisect*)",
    "Bash(git am*)",
    "Bash(git apply*)",
    "Bash(git notes*)",
    "Bash(git sparse-checkout*)",
    "Bash(git replace*)",
    "Bash(git maintenance*)",
    "Bash(git repack*)",
    "Bash(git prune*)",
    "Bash(git archive*)",
    "Bash(git format-patch*)",
    "Bash(git send-email*)",
    "Bash(git bundle*)",
    "Bash(git mv*)",
    "Bash(git credential*)",
    "Bash(git mergetool*)",
    "Bash(git difftool*)",
    "Bash(git rerere*)",
    "Bash(git clean*)",
    "Bash(git daemon*)",
    "Bash(git instaweb*)",
    "Bash(git commit*)",
    "Bash(git add -A*)",
    "Bash(git add -u*)",
    "Bash(git add -p*)",
    "Bash(git add -i*)",
    "Bash(git add .)",
    "Bash(git pull*)",
    "Bash(git switch*)",
    "Bash(git branch -d*)",
    "Bash(git branch -D*)",
    "Bash(git branch -m*)",
    "Bash(git branch -M*)",
    "Bash(git branch --set-upstream-to*)",
    "Bash(git branch --unset-upstream*)",
    "Bash(git branch --edit-description*)",
    "Bash(git worktree add*)",
    "Bash(git worktree remove*)",
    "Bash(git worktree prune*)",
    "Bash(git worktree lock*)",
    "Bash(git worktree unlock*)",
    "Bash(git worktree move*)",
    "Bash(git worktree repair*)",
    "Bash(git stash push*)",
    "Bash(git stash pop*)",
    "Bash(git stash apply*)",
    "Bash(git stash drop*)",
    "Bash(git stash clear*)",
    "Bash(git stash branch*)",
    // apps  -------------------------------------------------------------------
    "Bash(docker *)"
  ],
  "deny": [  // ################################################################

  ]
}