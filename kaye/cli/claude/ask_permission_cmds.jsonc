// #############################################################################
// ask_permission_cmds.jsonc
//
// Bash command patterns that require user permission before running,
// written to the "permissions.ask" list in settings.json
// #############################################################################
[
  // system commands  ----------------------------------------------------------
  "Bash(sudo *)",
  "Bash(su)",
  "Bash(kill *)",
  "Bash(killall *)",
  "Bash(shutdown *)",
  "Bash(reboot)",
  "Bash(systemctl *)",
  // packages  -----------------------------------------------------------------
  "Bash(npm install *)",
  "Bash(brew install *)",
  "Bash(apt *)",
  // Python  -------------------------------------------------------------------
  "Bash(pip install *)",
  "Bash(pytest .)",
  "Bash(pytest tests*)",
  // apps  ---------------------------------------------------------------------
  "Bash(git *)",
  "Bash(docker *)"
]
