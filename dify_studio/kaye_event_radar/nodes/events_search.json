{
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Short human-readable event title"
          },
          "link": {
            "type": "string",
            "format": "uri",
            "description": "URL to detailed event information"
          },
          "date": {
            "type": "string",
            "description": "Month and day in MM-DD format"
          },
          "time": {
            "type": "string",
            "description": "Start time as HH:MM or range HH:MM ~ HH:MM (24-hour)"
          },
          "price": {
            "type": "string",
            "description": "Admission price or fee",
            "examples": [
              "$15.00",
              "free"
            ]
          },
          "location": {
            "type": "string",
            "description": "Single-line address; omit state, country, postal code",
            "examples": [
              "Central Library, 123 Main St, Springfield",
              "Student Hall, USC, Los Angeles"
            ]
          },
          "summary": {
            "type": "string",
            "description": "concise summary in 1 or more paragraphs; use Briefness Style; **bold** for emphasis; expressive many emojis along key info; omit date, time, location in summary"
          }
        },
        "required": [
          "name",
          "link",
          "date",
          "time",
          "location",
          "summary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": false
}